# 复制为服务器上的 .env（与 docker-compose.yml 同目录），勿提交 Git
POSTGRES_USER=interview
POSTGRES_PASSWORD=请换成强密码
POSTGRES_DB=interview_system

# 公网访问地址（IP 或域名）。用 IP 时例如 http://1.2.3.4
NEXTAUTH_URL=http://你的服务器公网IP或域名
NEXTAUTH_SECRET=请用 openssl rand -base64 32 生成

# 首次部署设为 true 灌入演示账号；之后改为 false 再 up，避免每次启动清库
RUN_SEED=true

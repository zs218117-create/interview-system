    "postinstall": "prisma generate",
    "build:prod": "bash scripts/vercel-build.sh",
    "vercel-build": "bash scripts/vercel-build.sh",
    "db:use-sqlite": "bash scripts/use-sqlite.sh",
    "db:use-postgres": "bash scripts/use-postgres.sh"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.6.1",

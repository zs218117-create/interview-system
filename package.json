    "next": "14.2.35",
    "next-auth": "^4.24.15",
    "pdf-parse": "^2.4.5",
    "react": "^18",
    "react-dom": "^18",
    "tar": "^7.5.22",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/bcryptjs": "^3.0.0",

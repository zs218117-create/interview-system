# 复制到 Vercel → Project → Settings → Environment Variables
# （Neon 连接串等由你在控制台粘贴，勿把真实密码提交进 Git）

# 必填：生产站点地址（部署后改成真实 URL，不要末尾斜杠）
NEXTAUTH_URL="https://你的项目.vercel.app"

# 必填：已生成的示例密钥（上线前可再在本机重新 openssl rand -base64 32）
NEXTAUTH_SECRET="5pTsiUWRaQZ3HJtU2znuJAeh5hwvJSwWjR5FYaUk7v8="

# 必填：Neon（或其他）PostgreSQL 连接串
# 在 Neon 控制台复制「Connection string」，一般需带 sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# 可选：对象存储（文件上传上线后再接，当前仍可用「外部链接」）
# BLOB_READ_WRITE_TOKEN=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

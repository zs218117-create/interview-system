# —— 本地开发（默认 SQLite）——
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="请换成足够长的随机字符串（开发可用任意长串）"

# —— 生产（Vercel + Neon）请看 .env.production.example ——
# 构建使用：npm run vercel-build / Vercel 的 buildCommand
# 需要：NEXTAUTH_URL、NEXTAUTH_SECRET、DATABASE_URL（postgresql://...）

# —— 可选：本机 Docker Postgres（docker compose up -d）——
# DATABASE_URL="postgresql://interview:interview@localhost:5432/interview_system"

# —— 可选：对象存储（Phase 3）——
# BLOB_READ_WRITE_TOKEN=
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=
